{
  "version": 1,
  "description": "残留路径模板。{name}=显示名, {bundle_name}=CFBundleName, {bundle_id}=包标识符",
  "templates": [
    {"path": "~/Library/Application Support/{bundle_id}", "kind": "dir", "confidence": "high", "label": "应用数据"},
    {"path": "~/Library/Application Support/{name}", "kind": "dir", "confidence": "medium", "label": "应用数据"},
    {"path": "~/Library/Application Support/{bundle_name}", "kind": "dir", "confidence": "medium", "label": "应用数据"},
    {"path": "~/Library/Caches/{bundle_id}", "kind": "dir", "confidence": "high", "label": "缓存"},
    {"path": "~/Library/Caches/{name}", "kind": "dir", "confidence": "medium", "label": "缓存"},
    {"path": "~/Library/Preferences/{bundle_id}.plist", "kind": "file", "confidence": "high", "label": "偏好设置"},
    {"path": "~/Library/Preferences/{bundle_id}.savedState", "kind": "dir", "confidence": "high", "label": "偏好状态"},
    {"path": "~/Library/Logs/{name}", "kind": "dir", "confidence": "medium", "label": "日志"},
    {"path": "~/Library/Logs/{bundle_id}", "kind": "dir", "confidence": "high", "label": "日志"},
    {"path": "~/Library/Saved Application State/{bundle_id}.savedState", "kind": "dir", "confidence": "high", "label": "窗口状态"},
    {"path": "~/Library/HTTPStorages/{bundle_id}", "kind": "dir", "confidence": "high", "label": "网络存储"},
    {"path": "~/Library/HTTPStorages/{bundle_id}.binarycookies", "kind": "file", "confidence": "high", "label": "Cookie"},
    {"path": "~/Library/WebKit/{bundle_id}", "kind": "dir", "confidence": "high", "label": "WebKit 数据"},
    {"path": "~/Library/Cookies/{bundle_id}.binarycookies", "kind": "file", "confidence": "high", "label": "Cookie"},
    {"path": "~/Library/Containers/{bundle_id}", "kind": "dir", "confidence": "high", "label": "沙盒容器"},
    {"path": "~/Library/Application Scripts/{bundle_id}", "kind": "dir", "confidence": "high", "label": "应用脚本"},
    {"path": "~/Library/LaunchAgents/{bundle_id}.plist", "kind": "file", "confidence": "high", "label": "登录启动项"},
    {"path": "~/Library/PreferencePanes/{name}.prefPane", "kind": "dir", "confidence": "medium", "label": "系统偏好面板"},
    {"path": "~/Library/QuickLook/{name}.qlgenerator", "kind": "dir", "confidence": "medium", "label": "快速预览插件"},
    {"path": "~/Library/Services/{name}.workflow", "kind": "dir", "confidence": "medium", "label": "服务菜单"},
    {"path": "/Library/Application Support/{name}", "kind": "dir", "confidence": "medium", "label": "全局数据", "privileged": true},
    {"path": "/Library/Application Support/{bundle_id}", "kind": "dir", "confidence": "high", "label": "全局数据", "privileged": true},
    {"path": "/Library/Caches/{bundle_id}", "kind": "dir", "confidence": "high", "label": "全局缓存", "privileged": true},
    {"path": "/Library/Preferences/{bundle_id}.plist", "kind": "file", "confidence": "high", "label": "全局偏好", "privileged": true},
    {"path": "/Library/LaunchAgents/{bundle_id}.plist", "kind": "file", "confidence": "high", "label": "全局启动项", "privileged": true},
    {"path": "/Library/LaunchDaemons/{bundle_id}.plist", "kind": "file", "confidence": "high", "label": "后台守护进程", "privileged": true}
  ],
  "globs": [
    {"pattern": "~/Library/Application Support/{bundle_id}*", "kind": "any", "confidence": "high", "label": "应用数据变体"},
    {"pattern": "~/Library/Caches/{bundle_id}*", "kind": "any", "confidence": "high", "label": "缓存变体"},
    {"pattern": "~/Library/HTTPStorages/{bundle_id}*", "kind": "any", "confidence": "high", "label": "网络存储变体"},
    {"pattern": "~/Library/Preferences/{bundle_id}.*.plist", "kind": "file", "confidence": "high", "label": "偏好设置变体"},
    {"pattern": "~/Library/Preferences/ByHost/{bundle_id}.*.plist", "kind": "file", "confidence": "high", "label": "主机偏好"},
    {"pattern": "~/Library/LaunchAgents/*{bundle_id}*.plist", "kind": "file", "confidence": "high", "label": "登录启动项"},
    {"pattern": "/Library/LaunchAgents/*{bundle_id}*.plist", "kind": "file", "confidence": "high", "label": "全局启动项", "privileged": true},
    {"pattern": "/Library/LaunchDaemons/*{bundle_id}*.plist", "kind": "file", "confidence": "high", "label": "后台守护进程", "privileged": true},
    {"pattern": "/Library/PrivilegedHelperTools/*{bundle_id}*", "kind": "any", "confidence": "high", "label": "特权助手", "privileged": true}
  ],
  "keep_config_labels": ["应用数据", "偏好设置", "偏好状态", "偏好设置变体", "主机偏好", "全局数据", "全局偏好"]
}
